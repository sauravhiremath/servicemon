{
  "name": "servicemon",
  "version": "0.1.4",
  "description": "One manager for local development services",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/sauravhiremath/servicemon.git"
  },
  "homepage": "https://github.com/sauravhiremath/servicemon#readme",
  "bugs": {
    "url": "https://github.com/sauravhiremath/servicemon/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "os": [
    "darwin"
  ],
  "bin": {
    "servicemon": "dist/cli/main.js"
  },
  "files": [
    "dist",
    "docs/config.md",
    "docs/cli.md",
    "docs/operations.md",
    "docs/releasing.md",
    "CONTRIBUTING.md",
    "examples",
    "skills/servicemon",
    "LICENSE"
  ],
  "scripts": {
    "build": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --deny-warnings --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "knip --treat-config-hints-as-errors",
    "test": "npm run build && vitest run",
    "test:e2e": "npm run build && playwright test",
    "test:compose": "vitest run --config vitest.compose.config.ts",
    "smoke": "node scripts/smoke.mjs",
    "smoke:compose": "node scripts/smoke-compose.mjs",
    "smoke:startup": "node scripts/smoke-startup.mjs",
    "smoke:update": "node scripts/smoke-update.mjs",
    "check:runtime": "node scripts/check-runtime.mjs",
    "release:formula": "node scripts/prepare-formula.mjs",
    "release:check": "node scripts/release-check.mjs",
    "release:source": "node scripts/release-source.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "commander": "^15.0.0",
    "hono": "^4.13.12",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/css-tree": "^4.1.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-table": "^9.2.4",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "knip": "^6.39.0",
    "lucide-react": "^1.49.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-resizable-panels": "^4.14.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^4.1.11"
  }
}
