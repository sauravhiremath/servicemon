{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "semi": true,
  "printWidth": 100,
  "proseWrap": "preserve",
  "sortPackageJson": false,
  "sortImports": {
    "groups": ["builtin", "external", "internal", "parent", "sibling", "index"],
    "partitionByNewline": false,
    "newlinesBetween": false
  },
  "sortTailwindcss": {
    "stylesheet": "./src/web/styles.css",
    "functions": ["cn", "clsx", "cva"]
  },
  "ignorePatterns": [
    "package-lock.json",
    "dist/**",
    "test-results/**",
    "playwright-report/**",
    ".orca/**",
    "release-artifacts/**"
  ]
}
